{
  "name": "flashcards-editor",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "next lint",
    "seed": "node scripts/seed.mjs",
    "preview": "npx serve out -l 3210",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "test:model": "tsx scripts/test-model.ts",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "isomorphic-git": "^1.27.1",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.kirill.flashcards",
    "productName": "Flashcards",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flashcards"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bablakov",
        "repo": "flashcards"
      }
    ]
  }
}